<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Screen" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:Label name="Title" text="FigmaFlow Bottom Sheet Demo" style="font-size: 24px; -unity-text-align: middle-center;" />
    </ui:VisualElement>

    <ui:VisualElement name="Backdrop" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5);" />

    <ui:VisualElement name="BottomSheetPanel" style="position: absolute; left: 0; right: 0; bottom: 0; height: 220px; background-color: rgba(255, 255, 255, 0.97); border-top-left-radius: 12px; border-top-right-radius: 12px; align-items: center; justify-content: center;">
        <ui:Label name="SheetTitle" text="Bottom Sheet" style="font-size: 20px; margin-bottom: 16px;" />
        <ui:Button name="CloseSheet" text="Bezárás" style="width: 120px; height: 40px;" />
    </ui:VisualElement>
</ui:UXML>
