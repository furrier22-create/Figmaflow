<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Screen" style="flex-grow: 1;">
        <ui:VisualElement name="TopBar" style="flex-direction: row; justify-content: flex-end; padding: 16px;">
            <ui:Button name="OpenMenu" text="Menü" style="width: 100px; height: 40px;" />
        </ui:VisualElement>
        <ui:Label name="Title" text="FigmaFlow Popup Demo" style="font-size: 24px; -unity-text-align: middle-center; margin-top: 80px;" />
    </ui:VisualElement>

    <ui:VisualElement name="MenuPanel" style="position: absolute; top: 64px; right: 16px; width: 180px; background-color: rgba(255, 255, 255, 0.97); border-radius: 8px; padding: 8px;">
        <ui:Button name="OptionProfile" text="Profil" style="width: 100%; height: 36px; margin-bottom: 4px;" />
        <ui:Button name="OptionSettings" text="Beállítások" style="width: 100%; height: 36px; margin-bottom: 4px;" />
        <ui:Button name="OptionLogout" text="Kijelentkezés" style="width: 100%; height: 36px;" />
    </ui:VisualElement>
</ui:UXML>
